# Port the Express server listens on.
# Render sets this automatically at deploy time; keep 5000 for local dev.
PORT=5000

# Secret used to sign/verify JWT auth tokens. Set a strong random value in production.
JWT_SECRET=supersecretkey

# Base URL of the deployed ML inference service (FastAPI, ml-service/).
# Local dev default (no trailing slash):
ML_SERVICE_URL=http://127.0.0.1:8000
# Render production example:
# ML_SERVICE_URL=https://revalue-ml-service.onrender.com

# Origin(s) allowed to call this API (CORS). Comma-separate multiple origins.
# If left unset, all origins are allowed (useful for local dev only).
# Netlify production example:
# FRONTEND_URL=https://revalue-app.netlify.app
FRONTEND_URL=
