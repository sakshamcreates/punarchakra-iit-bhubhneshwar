# Base URL of the deployed backend API (must include /api).
# Local dev default:
VITE_API_BASE_URL=http://localhost:5000/api
# Render production example:
# VITE_API_BASE_URL=https://revalue-backend.onrender.com/api

# If true, pages fall back to bundled mock data when the API is unreachable.
VITE_ENABLE_API_FALLBACK=true
